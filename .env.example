# Copy to .env for local testing. On Pella, set these in the server's environment/.env instead.
DISCORD_TOKEN=your-bot-token-here
# Optional: prefix for text commands
PREFIX=!
# IEMRanking.com API key for /search, /top, /compare, /recommend (keep secret, never commit)
IEMRANKING_API_KEY=
# Optional: bot-wide cap on IEMRanking API calls per minute (keep a bit under your key's limit)
IEMRANKING_MAX_PER_MINUTE=20
